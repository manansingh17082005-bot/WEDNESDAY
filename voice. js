
(() => {
  const OLLAMA_URL = "http://localhost:11434/api/chat";
  const MODEL = "llama3.2";

  let selectedVoice = "male";
  let selectedLanguage = "en-IN";
  let recognition = null;
  let busy = false;

  const history = [{
    role: "system",
    content: "You are WEDNESDAY, Manan's personal AI assistant. Be helpful, intelligent, concise and natural. Understand Hindi, English and Hinglish. Reply in the language the user uses. You may use a confident, composed personality."
  }];

  const $ = (selector) => document.querySelector(selector);

  function addBubble(type, text) {
    const bubble = document.createElement("div");
    bubble.className = type === "user" ? "user-bubble" : "assistant-bubble";

    const content = document.createElement("p");
    content.textContent = text;
    bubble.appendChild(content);

    $("#chat-body").appendChild(bubble);
    bubble.scrollIntoView({ behavior: "smooth", block: "nearest" });
    return bubble;
  }

  function setupControls() {
    const form = $("#chat-form");
    if (!form || $("#voice-controls")) return;

    const controls = document.createElement("div");
    controls.id = "voice-controls";
    controls.style.cssText =
      "display:flex;flex-wrap:wrap;gap:9px;padding:12px 14px;align-items:center;border-top:1px solid #293449;";

    controls.innerHTML = `
      <select id="wednesday-voice" aria-label="Assistant voice"
        style="background:#202a3c;color:white;border:1px solid #34415b;padding:9px;border-radius:8px;">
        <option value="male">Male voice</option>
        <option value="female">Female voice</option>
        <option value="kratos">Kratos style</option>
      </select>

      <select id="wednesday-language" aria-label="Speech language"
        style="background:#202a3c;color:white;border:1px solid #34415b;padding:9px;border-radius:8px;">
        <option value="en-IN">English (India)</option>
        <option value="hi-IN">Hindi (India)</option>
      </select>

      <button type="button" id="wednesday-mic"
        style="background:#39345e;color:white;border:1px solid #625a99;padding:9px 13px;border-radius:8px;cursor:pointer;">
        🎙 Speak
      </button>

      <button type="button" id="wednesday-stop"
        style="background:#512c36;color:#ffb4b4;border:1px solid #75414b;padding:9px 13px;border-radius:8px;cursor:pointer;">
        Stop voice
      </button>

      <span id="wednesday-status" style="font-size:10px;color:#aab5c7;">
        Connecting to local Llama 3.2…
      </span>
    `;

    form.parentNode.insertBefore(controls, form);

    $("#wednesday-voice").addEventListener("change", e => {
      selectedVoice = e.target.value;
    });

    $("#wednesday-language").addEventListener("change", e => {
      selectedLanguage = e.target.value;
    });

    $("#wednesday-mic").addEventListener("click", startListening);

    $("#wednesday-stop").addEventListener("click", () => {
      window.speechSynthesis?.cancel();
      if (recognition) recognition.stop();
      setStatus("Voice stopped.");
    });
  }

  function setStatus(message) {
    const status = $("#wednesday-status");
    if (status) status.textContent = message;
  }

  function getAvailableVoices() {
    return window.speechSynthesis
      ? window.speechSynthesis.getVoices()
      : [];
  }

  function chooseVoice() {
    const voices = getAvailableVoices();
    if (!voices.length) return null;

    const languagePrefix = selectedLanguage.split("-")[0];

    const matching = voices.filter(v =>
      v.lang.toLowerCase().startsWith(languagePrefix.toLowerCase())
    );

    const candidates = matching.length ? matching : voices;

    if (selectedVoice === "female") {
      return candidates.find(v =>
        /female|zira|samantha|susan|karen|heera|priya|veena/i.test(v.name)
      ) || candidates[0];
    }

    return candidates.find(v =>
      /male|david|mark|daniel|alex|ravi|google.*english/i.test(v.name)
    ) || candidates[0];
  }

  function speak(text) {
    if (!window.speechSynthesis) {
      setStatus("Speech output is not supported in this browser.");
      return;
    }

    window.speechSynthesis.cancel();

    const utterance = new SpeechSynthesisUtterance(text);
    const voice = chooseVoice();

    if (voice) {
      utterance.voice = voice;
      utterance.lang = voice.lang;
    } else {
      utterance.lang = selectedLanguage;
    }

    if (selectedVoice === "kratos") {
      utterance.pitch = 0.55;
      utterance.rate = 0.82;
      utterance.volume = 1;
    } else if (selectedVoice === "female") {
      utterance.pitch = 1.08;
      utterance.rate = 0.96;
    } else {
      utterance.pitch = 0.88;
      utterance.rate = 0.94;
    }

    utterance.onstart = () => setStatus("WEDNESDAY is speaking…");
    utterance.onend = () => setStatus("Ready.");
    utterance.onerror = () => setStatus("Speech playback failed.");

    window.speechSynthesis.speak(utterance);
  }

  async function askOllama(message) {
    history.push({ role: "user", content: message });

    // Keep a manageable conversation history.
    if (history.length > 21) {
      history.splice(1, 2);
    }

    const response = await fetch(OLLAMA_URL, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        model: MODEL,
        messages: history,
        stream: false
      })
    });

    if (!response.ok) {
      throw new Error("Ollama returned HTTP " + response.status);
    }

    const data = await response.json();
    const answer = data.message?.content?.trim();

    if (!answer) {
      throw new Error("The model returned an empty response.");
    }

    history.push({ role: "assistant", content: answer });
    return answer;
  }

  async function sendMessage(message) {
    if (!message || busy) return;

    busy = true;
    addBubble("user", message);

    const waiting = addBubble("assistant", "Thinking…");
    setStatus("Asking Llama 3.2…");

    const input = $("#chat-input");
    if (input) input.value = "";

    try {
      const answer = await askOllama(message);
      waiting.querySelector("p").textContent = answer;
      waiting.scrollIntoView({ behavior: "smooth", block: "nearest" });
      speak(answer);
    } catch (error) {
      waiting.querySelector("p").textContent =
        "I couldn't connect to Ollama. Make sure Ollama is running and that llama3.2 is installed. Details: " +
        error.message;

      setStatus("AI connection failed.");
    } finally {
      busy = false;
    }
  }

  function startListening() {
    const SpeechRecognition =
      window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
      setStatus("Speech recognition is not supported. Try Chrome.");
      return;
    }

    if (recognition) recognition.stop();

    recognition = new SpeechRecognition();
    recognition.lang = selectedLanguage;
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;

    recognition.onstart = () => {
      setStatus("Listening… Speak now.");
      $("#wednesday-mic").textContent = "🔴 Listening";
    };

    recognition.onresult = event => {
      const transcript = event.results[0][0].transcript.trim();
      if (transcript) sendMessage(transcript);
    };

    recognition.onerror = event => {
      setStatus("Microphone error: " + event.error);
    };

    recognition.onend = () => {
      $("#wednesday-mic").textContent = "🎙 Speak";
    };

    recognition.start();
  }

  // Intercept the existing demo chat handler before it runs.
  document.addEventListener("submit", event => {
    if (event.target.id !== "chat-form") return;

    event.preventDefault();
    event.stopImmediatePropagation();

    const message = $("#chat-input")?.value.trim();
    if (message) sendMessage(message);
  }, true);

  function init() {
    setupControls();

    if (window.speechSynthesis) {
      window.speechSynthesis.onvoiceschanged = () => {
        getAvailableVoices();
      };
    }

    setStatus("Ready. Connect to local Llama 3.2.");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
